page {
  min-height: 100%;
  color: #1a1a1a;
  background: radial-gradient(ellipse at 50% 0%, #fbfaf6, #f3f1ec 52%, #e7e4de);
  background-attachment: fixed;
  font: 29rpx -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}
.page { padding: 24rpx 36rpx 48rpx; }
.row,.head { display: flex; align-items: center; gap: 16rpx; }
.head { justify-content: space-between; margin: 8rpx 0 22rpx; }
.title { font-size: 54rpx; font-weight: 800; letter-spacing: -2rpx; }
.subhead { font-size: 32rpx; font-weight: 750; }
.muted,.count { color: #746e63; font-size: 25rpx; }
.count { font-variant-numeric: tabular-nums; }
.review-reason { overflow-wrap: break-word; white-space: pre-wrap; }
.panel {
  margin: 18rpx 0;
  padding: 24rpx;
  border: 1rpx solid #e4e0d7;
  border-radius: 34rpx;
  background: #fbfaf7;
  box-shadow: 0 5px 20px rgba(29, 25, 16, .06);
}
.btn,.chip {
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 12rpx 24rpx;
  margin: 0;
  border-radius: 99rpx;
  background: #efede6;
  color: #292722;
  font: inherit;
  line-height: 1.3;
}
.btn::after,.chip::after { border: 0; }
.primary,.active { color: #fbfaf7; background: #1a1a1a; }
.btn[disabled] { opacity: .45; }
.mini { font-size: 24rpx; padding: 10rpx 20rpx; }
.wrap { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; }
.field { margin: 24rpx 0 10rpx; color: #5d584e; font-size: 25rpx; }
.entry { background: #efede6; padding: 17rpx; border-radius: 16rpx; }
.space { margin-top: 22rpx; }
.empty { text-align: center; color: #746e63; padding: 70rpx 20rpx; }
.line { display: flex; align-items: center; justify-content: space-between; border-top: 1rpx solid #ede9df; padding: 18rpx 0; }
.thumb { width: 75rpx; height: 75rpx; border-radius: 12rpx; background: #efede6; }
.grow { flex: 1; min-width: 0; }
.danger { color: #a23c54; }
.pill { padding: 4rpx 12rpx; font-size: 22rpx; background: #f3dfea; color: #783c65; border-radius: 20rpx; }
.tab-page { padding-bottom: calc(88px + env(safe-area-inset-bottom)); }
