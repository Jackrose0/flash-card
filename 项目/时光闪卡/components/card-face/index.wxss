.card { position: relative; overflow: hidden; border-radius: 14rpx; }
.card::before { content: ""; display: block; padding-top: 140%; }
.r1x1::before { padding-top: 100%; }
.r7x5::before { padding-top: 71.4286%; }
.layer { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.subject { position: absolute; left: 12%; top: 13%; width: 76%; height: 67%; }
.label { position: absolute; bottom: 8%; left: 10%; max-width: 80%; font-size: 14px; line-height: 1; font-weight: 750; color: #fffaf0; text-shadow: 0 1px 4px #45354c; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.number,.english { position: absolute; color: #faeac1; font-size: 7px; line-height: 1; white-space: nowrap; }
.number { top: 4.5%; left: 87.4%; transform: translateX(-50%); font-family: monospace; font-weight: 700; }
.english { bottom: 3.6%; right: 21%; font-family: Georgia, serif; font-style: italic; }
.gallery .label { font-size: 10px; }
.gallery .number,.gallery .english { font-size: 5px; }
.star { color: #ffe791; }
