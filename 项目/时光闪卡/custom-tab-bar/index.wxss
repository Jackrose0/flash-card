.bar {
  position: fixed;
  z-index: 15;
  left: 50%;
  bottom: calc(16px + env(safe-area-inset-bottom));
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  padding: 3px 7px;
  border: 1px solid #ffffffe0;
  border-radius: 100px;
  background: #fbfaf7ef;
  box-shadow: 0 10px 30px rgba(37, 31, 22, .16);
}
.nav {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  min-height: 44px;
  margin: 0;
  padding: 0;
  border-radius: 99px;
  background: transparent;
}
.nav::after { border: 0; }
.nav-item { display: flex; align-items: center; padding: 0 13px; height: 31px; border-radius: 99px; white-space: nowrap; color: #5d574b; font: 700 13px/1 -apple-system, "PingFang SC", sans-serif; }
.selected .nav-item { background: #fffefa; color: #1a1a1a; box-shadow: 0 3px 9px rgba(29, 24, 16, .13); }
