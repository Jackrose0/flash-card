page { background: #eeeae0; color: #1a1a1a; }
.room { display: flex; flex-direction: column; min-height: 100vh; box-sizing: border-box; }
.display { flex: 1; display: flex; align-items: center; justify-content: center; min-height: 48vh; padding: 10px 0; }
.board { position: relative; flex: none; }
.viewer,.original { display: block; width: 100%; height: 100%; }
.original { position: absolute; left: -200vw; top: 0; pointer-events: none; }
.original.shown { left: 0; }
.dock { padding: 8px 16px calc(14px + env(safe-area-inset-bottom)); text-align: center; }
.tools,.exports { display: flex; justify-content: center; gap: 8px; }
.tool,.export { display: flex; align-items: center; justify-content: center; min-height: 44px; margin: 0; padding: 0 14px; border-radius: 100px; color: #27231e; background: #fffdf6da; font-size: 13px; line-height: 1.4; white-space: nowrap; }
.tool::after,.export::after { border: 0; }
.tool.on,.exports .share-file { color: #fbfaf7; background: #1a1a1a; }
.tool[disabled],.export[disabled] { opacity: .45; }
.settings { max-width: 480px; margin: 10px auto; }
.slider { display: flex; align-items: center; gap: 8px; font-size: 12px; }
.slider slider { flex: 1; }
.slider text { min-width: 43px; }
.exports { margin-top: 8px; }
.exports .export:first-child { background: transparent; }
