.room { position: relative; display: flex; flex-direction: column; height: 100vh; overflow: hidden; }
.top { position: absolute; z-index: 1; left: 16px; right: 104px; display: flex; align-items: center; gap: 10px; font-weight: 750; font-size: 16px; pointer-events: none; }
.top text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.back { display: grid; place-items: center; flex: none; min-height: 44px; margin: 0; padding: 0 15px; border-radius: 999px; background: #fffefae8; color: #20201d; font-size: 13px; line-height: 1.4; pointer-events: auto; }
.back::after { border: 0; }
.stage { position: relative; flex: 1; min-height: 0; }
.scene { display: block; width: 100%; height: 100%; }
.touch-layer { position: absolute; inset: 0; }
.foot { display: grid; justify-items: center; gap: 8px; padding: 6px 16px calc(18px + env(safe-area-inset-bottom)); font-size: 13px; color: #635d52; }
.foot text { min-height: 19px; }
.foot button { font-weight: 700; box-shadow: 0 5px 16px rgba(27, 24, 21, .18); }
