.draw-page {
  box-sizing: border-box;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding-bottom: calc(72px + env(safe-area-inset-bottom));
}
.draw-main { display: flex; flex-direction: column; flex: 1; min-height: 0; }
.draw-title { text-align: center; font-size: 28px; font-weight: 800; letter-spacing: -.8px; padding-top: 14px; }
.fan-stage { position: relative; flex: 1; min-height: 0; overflow: hidden; touch-action: pan-y; }
.fan-pack {
  position: absolute;
  left: 50%;
  bottom: 42px;
  transform-origin: center bottom;
  padding: 0;
  border-radius: 4rpx;
  overflow: visible;
  margin: 0;
  background: transparent;
  will-change: transform, opacity;
}
.fan-pack::after,.pool-dot::after { border: 0; }
.fan-pack image { display: block; width: 100%; height: 100%; filter: drop-shadow(0 9px 12px rgba(39, 24, 29, .23)); pointer-events: none; }
.fan-pack.offstage { pointer-events: none; visibility: hidden; }
.pool-summary { position: relative; z-index: 1; text-align: center; padding: 4px 16px 0; }
.pool-name { font-size: 22px; font-weight: 800; line-height: 1.2; letter-spacing: -.4px; }
.pool-meta { font-size: 13px; color: #746e63; margin: 5px 0 10px; }
.draw-action { min-width: 114px; min-height: 44px; font-size: 15px; font-weight: 750; box-shadow: 0 6px 18px rgba(28, 26, 24, .19); }
.spark { color: #f2df94; margin-left: 6px; }
.pool-dots { display: flex; justify-content: center; padding: 0 13px; }
.pool-dot { display: grid; place-items: center; width: 35px; min-width: 0; height: 42px; border-radius: 0; margin: 0; padding: 0; background: transparent; }
.pool-dot view { width: 7px; height: 7px; border-radius: 999px; background: #a49d90; transition: width .18s ease, background-color .18s ease; }
.pool-dot.chosen view { width: 18px; background: #1c1b19; }
@media (max-height: 640px) {
  .draw-title { font-size: 24px; padding-top: 7px; }
  .fan-pack { bottom: 26px; }
  .pool-dot { height: 34px; }
}
