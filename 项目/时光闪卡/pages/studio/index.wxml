<brand-header role-name="{{roleName}}"/>
<view class="page tab-page" wx:if="{{who && who.role!=='user'}}">
<view wx:if="{{!section}}">
  <view class="title studio-title">管理</view>
  <button wx:for="{{sections}}" wx:key="id" class="studio-entry" data-section="{{item.id}}" data-title="{{item.title}}" bindtap="section">
    <text class="entry-icon {{item.tint}}" aria-hidden="true">{{item.icon}}</text>
    <text>{{item.title}}</text>
    <text class="entry-arrow" aria-hidden="true">›</text>
  </button>
</view>
<block wx:else>
<view class="studio-heading">
  <button class="btn mini" bindtap="hub" aria-label="返回管理">‹ 管理</button>
  <view class="title">{{sectionTitle}}</view>
</view>
<view wx:if="{{section==='卡池'}}" class="panel"><view class="head pool-actions"><button class="btn mini" bindtap="newPool">新增卡池</button></view>
<view wx:for="{{poolList}}" wx:key="id" class="line" data-id="{{item.id}}" bindtap="configure"><text>{{item.name}}</text><text class="count">{{item.count}} 款　›</text></view></view>
<block wx:elif="{{section==='制卡'}}"><view class="panel"><view class="field first">卡片比例</view><view class="wrap"><button wx:for="{{ratios}}" wx:key="*this" data-value="{{item}}" bindtap="ratio" class="chip mini {{draft.ratio===item?'active':''}}">{{item}}</button></view>
<view class="field">上层框</view><picker range="{{frames}}" range-key="name" value="{{frameIndex}}" bindchange="frame"><view class="entry">{{frames[frameIndex].name}} ▾</view></picker>
<view class="field">背景</view><picker range="{{backgrounds}}" range-key="name" value="{{bgIndex}}" bindchange="background"><view class="entry">{{backgrounds[bgIndex].name}} ▾</view></picker>
<view wx:if="{{!draft.background}}" class="row space"><view class="swatch" style="background:{{draft.color}}"></view><input class="entry grow" maxlength="7" value="{{colorText}}" bindinput="color" placeholder="#F5DDE6"/></view>
<view class="field">卡池</view><picker range="{{pools}}" range-key="name" value="{{poolIndex}}" bindchange="pool"><view class="entry">{{pools[poolIndex].name}} ▾</view></picker>
<view class="line space"><text>稀有闪卡</text><switch checked="{{draft.special}}" bindchange="special" color="#575346"/></view></view>
<view class="head"><text class="subhead">中层图片 · {{subjects.length}}</text><button class="btn mini" disabled="{{working}}" bindtap="chooseSubjects">批量选图</button></view>
<view class="cards"><view wx:for="{{previews}}" wx:key="key" class="preview"><card-face card="{{item}}"/><input value="{{item.name}}" data-index="{{index}}" maxlength="18" bindblur="rename" placeholder="卡片名称"/><button class="btn mini" data-index="{{index}}" bindtap="removeSubject">移除</button></view></view>
<button class="btn primary full" disabled="{{!subjects.length || working}}" bindtap="publish">生成 {{subjects.length || ''}} 张卡{{poolIndex ? '并加入卡池' : ''}}</button>
<view wx:if="{{created.length}}" class="panel"><text class="subhead">本次生成</text><view wx:for="{{created}}" wx:key="id" class="line" data-id="{{item.id}}" bindtap="detail"><text>{{item.name}}</text><text>查看 ↗</text></view></view></block>
<block wx:elif="{{section==='素材'}}"><view wx:for="{{groups}}" wx:key="key" class="panel" wx:for-item="group"><view class="head"><text class="subhead">{{group.name}}</text><button class="btn mini" disabled="{{working}}" data-kind="{{group.key}}" bindtap="addResource">新增</button></view>
<view wx:for="{{group.rows}}" wx:key="id" class="line"><view class="row grow"><image class="thumb" src="{{item.src}}" mode="aspectFit"/><text>{{item.name}} {{item.ratio || ''}}</text></view><button class="btn mini danger" data-kind="{{group.key}}" data-id="{{item.id}}" bindtap="removeResource">删除</button></view></view></block>
<view wx:else class="panel">
<view wx:for="{{profiles}}" wx:key="id" class="line profile-line"><view><text>{{item.name}}</text><view class="count">{{item.id}}</view></view><text wx:if="{{item.role==='owner'}}">店主</text><view wx:else class="profile-toggles"><label class="row">制卡员 <switch color="#575346" checked="{{item.role==='maker'}}" data-id="{{item.id}}" bindchange="grant"/></label><label class="row">下载互动卡 <switch color="#575346" checked="{{item.canDownloadCards}}" data-id="{{item.id}}" bindchange="grantDownload"/></label></view></view></view></block>
</view>
