.studio-title { margin: 2px 0 20px; }
.studio-entry {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  min-height: 65px;
  margin: 0 0 13px;
  padding: 10px 15px;
  border: 1px solid #e5e1d8;
  border-radius: 19px;
  background: #fbfaf7;
  box-shadow: 0 6px 18px rgba(31, 27, 19, .07);
  color: inherit;
  font: inherit;
  font-weight: 750;
  text-align: left;
}
.studio-entry::after { border: 0; }
.entry-icon { display: grid; place-items: center; width: 34px; height: 34px; flex: none; border-radius: 10px; font-size: 17px; }
.entry-icon.rose { background: #f4e1e9; color: #93516e; }
.entry-icon.blue { background: #e7eaf6; color: #575489; }
.entry-icon.green { background: #e7eee2; color: #4e7352; }
.entry-icon.gold { background: #f4ebd6; color: #8f672e; }
.entry-arrow { margin-left: auto; color: #8d8578; font-size: 20px; }
.studio-heading { margin: 0 0 15px; }
.studio-heading .title { margin-top: 7px; }
.pool-actions { justify-content: flex-end; margin-top: 0; }
.first { margin-top: 0; }
.cards { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.preview input { margin: 12rpx 0; background: #efede6; border-radius: 12rpx; padding: 8rpx; }
.full { display: flex; margin-top: 22rpx; }
.swatch { width: 50rpx; height: 50rpx; border-radius: 50%; border: 1rpx solid #c7bdac; }
.profile-line { flex-wrap: wrap; gap: 12rpx; }
.profile-toggles { display: grid; gap: 8rpx; }
.profile-toggles .row { justify-content: space-between; min-height: 44px; white-space: nowrap; }
.review-pack{width:84px;height:112px;margin-top:10px;display:block}
.review-actions{gap:10px;margin-top:14px;flex-wrap:wrap}
.audit-heading{display:block;margin:32rpx 0 12rpx}
.audit-empty{margin:0 0 20rpx}
.audit-row{display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:12rpx;min-height:78rpx}
.audit-row>text:first-child{word-break:break-word}
.audit-row .btn{margin:0;min-height:64rpx}
.audit-card{border-top:1rpx solid rgba(85,74,63,.13)}
.audit-card-name{justify-self:start;text-align:left;max-width:100%;white-space:normal}
.audit-members{display:block;margin:10rpx 0}
