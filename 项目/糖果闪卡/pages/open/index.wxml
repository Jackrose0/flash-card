<view class="room" style="background-color:{{pack.color}}">
  <view class="top" style="top:{{top}}px;min-height:{{barHeight}}px">
    <button aria-label="返回卡池" bindtap="back" class="back">‹ 卡池</button>
    <text>{{poolName}}</text>
  </view>
  <view class="stage">
    <canvas id="scene" type="2d" class="scene" aria-hidden="true"/>
    <view class="touch-layer" catchtouchstart="start" catchtouchmove="move" catchtouchend="end"
      catchtouchcancel="cancel" aria-label="{{opened ? '点卡片翻面' : poolName + '卡包'}}"/>
  </view>
  <view class="foot">
    <text>{{hint}}</text>
    <button class="btn primary" disabled="{{busy || !ready}}" bindtap="action">{{opened ? '再拆一包' : '一键拆包'}}</button>
  </view>
</view>
